{
  "name": "@gruber/media-server",
  "version": "8.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run prisma:generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/app.test.js",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "prisma:migrate:dev": "prisma migrate dev --config prisma.config.ts",
    "prisma:migrate:deploy": "prisma migrate deploy --config prisma.config.ts"
  },
  "dependencies": {
    "@gruber/contracts": "*",
    "@gruber/scene-renderer": "*",
    "@napi-rs/canvas": "^1.0.8",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "fastify": "5.11.2",
    "pdfjs-dist": "^5.4.624",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "prisma": "^7.9.1"
  }
}
